<service>
  <id>vcode</id>
  <name>vcode (TODO List)</name>
  <description>TODO List - Vue 3 + TailwindCSS, razdaetsya Node.js HTTP-serverom. Avtozapusk vmeste s serverom.</description>
  <executable>C:\Program Files\nodejs\node.exe</executable>
  <arguments>C:\opt\vcode\server.js</arguments>
  <workingdirectory>C:\opt\vcode</workingdirectory>
  <env name="PORT" value="3000"/>
  <env name="HOST" value="0.0.0.0"/>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="5 sec"/>
  <log mode="roll-by-size">
    <logpath>C:\opt\vcode\logs</logpath>
    <logsize>10240</logsize>
    <keepfiles>3</keepfiles>
  </log>
</service>
