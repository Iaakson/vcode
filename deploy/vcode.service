[Unit]
Description=TODO List (Vue 3 + Node.js static server)
After=network.target

[Service]
Type=simple
# Пользователь, от которого работает сервис (создаётся при деплое)
User=deploy
WorkingDirectory=/opt/vcode
# Порт 3000 требует прав — используется node с capabilities на bind <1024,
# поэтому сервис запускается с флагом AmbientCapabilities
ExecStart=/usr/bin/node /opt/vcode/server.js
Restart=always
RestartSec=5
Environment=PORT=3000
Environment=HOST=0.0.0.0
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Безопасность
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
